{
  "name": "ojos-de-falcon",
  "version": "0.1.0",
  "private": true,
  "description": "Navigation with public-safety infrastructure built into the map.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port ${PORT:-3100}",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3100}",
    "start:standalone": "node .next/standalone/server.js",
    "seed": "node scripts/seed.mjs",
    "import:osm": "node scripts/import-osm.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.1.1",
    "maplibre-gl": "^5.6.0",
    "next": "^16.1.6",
    "postcss": "^8.5.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.1.6",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
