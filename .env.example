# Ojos De Falcón — environment configuration
# All values optional; the app runs with zero configuration.

# Server port (default 3100)
#PORT=3100

# Data directory for the SQLite database (default ./.data, /data in Docker)
#OJOS_DATA_DIR=/data
# Or the full DB path directly:
#OJOS_DB_PATH=/data/ojos-de-falcon.db

# Force reloading seed/import data on next boot
#OJOS_RESEED=1

# Google Maps Platform key (server-side only — never exposed to the browser).
# When set, routing uses the Google Routes API and geocoding uses the Google
# Geocoding API. Enable "Routes API" and "Geocoding API" on the key's project.
# On shared infrastructure (e.g. server L), reuse the same key as sibling apps.
#GOOGLE_MAPS_API_KEY=

# Routing fallback: OSRM-compatible endpoint, used when no Google key is set.
# The public demo server is the default — fine for development, rate-limited
# for production. Self-host OSRM if you need keyless routing at scale.
#OSRM_URL=http://your-osrm:5000

# Map styles: any MapLibre-compatible style URL (MapTiler, self-hosted, etc.)
# Defaults to keyless CARTO raster basemaps.
#NEXT_PUBLIC_MAP_STYLE_DARK=
#NEXT_PUBLIC_MAP_STYLE_LIGHT=

# Geocoder: Nominatim-compatible endpoint (default: nominatim.openstreetmap.org)
#NEXT_PUBLIC_GEOCODER_URL=

# Overpass API endpoint for the OSM importer (scripts/import-osm.mjs)
#OVERPASS_URL=https://overpass-api.de/api/interpreter

# Google Places autocomplete (addresses + business type-ahead). Falls back to
# GOOGLE_MAPS_API_KEY, then plain geocoding, when unset.
GOOGLE_PLACES_API_KEY=
